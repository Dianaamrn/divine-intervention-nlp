                  "claim": {
                    "type": "string",
                    "minLength": 1
                  },
                  "verification_status": {
                    "enum": [
                      "unverified_draft",
                      "source_supported",
                      "qualified",
                      "rejected"
                    ]
                  },
                  "evidence_ids": {
                    "type": "array",
